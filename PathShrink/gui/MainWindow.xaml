<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PathShrink" Width="1100" Height="740" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#161618" Foreground="#E6E6E8"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" AllowDrop="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#161618"/>
    <SolidColorBrush x:Key="Surface" Color="#1D1D20"/>
    <SolidColorBrush x:Key="Surface2" Color="#242428"/>
    <SolidColorBrush x:Key="Line" Color="#33333A"/>
    <SolidColorBrush x:Key="Text" Color="#E6E6E8"/>
    <SolidColorBrush x:Key="Text2" Color="#B8B8BC"/>
    <SolidColorBrush x:Key="Gold" Color="#C9A96E"/>
    <SolidColorBrush x:Key="GoldHi" Color="#E2C48A"/>
    <SolidColorBrush x:Key="GoldLo" Color="#7A6440"/>
    <SolidColorBrush x:Key="Ok" Color="#7FC97F"/>
    <SolidColorBrush x:Key="Warn" Color="#E0C060"/>
    <SolidColorBrush x:Key="Bad" Color="#FF7B72"/>

    <DrawingImage x:Key="LogoImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#161618" Geometry="M0,0 H32 V32 H0 Z"/>
          <GeometryDrawing Geometry="M3,9 L10,16 L3,23 M29,9 L22,16 L29,23 M15,6 V26 M17,6 V26">
            <GeometryDrawing.Pen><Pen Brush="#C9A96E" Thickness="2.6" StartLineCap="Square" EndLineCap="Square" LineJoin="Miter"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Cut-corner button. The shape geometry is set from code on SizeChanged so the
         corners keep the same angle at any width. -->
    <Style x:Key="CutButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinWidth" Value="110"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Tag" Value="cut"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="Transparent">
              <Path x:Name="Shape" Stroke="{StaticResource Gold}" StrokeThickness="2" Fill="Transparent" Stretch="None"/>
              <Path x:Name="Focus" Stroke="{StaticResource GoldHi}" StrokeThickness="1" StrokeDashArray="2 2" Fill="Transparent" Stretch="None" Visibility="Collapsed" Margin="4"/>
              <ContentPresenter RecognizesAccessKey="True" x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shape" Property="Fill" Value="{StaticResource Gold}"/>
                <Setter Property="Foreground" Value="#161618"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shape" Property="Fill" Value="{StaticResource GoldLo}"/>
                <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource GoldLo}"/>
                <Setter Property="Foreground" Value="#F0F0F0"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource GoldHi}"/>
                <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CutButton}">
      <Setter Property="Foreground" Value="#161618"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="Transparent">
              <Path x:Name="Shape" Stroke="{StaticResource Gold}" StrokeThickness="2" Fill="{StaticResource Gold}" Stretch="None"/>
              <Path x:Name="Focus" Stroke="#161618" StrokeThickness="1" StrokeDashArray="2 2" Fill="Transparent" Stretch="None" Visibility="Collapsed" Margin="4"/>
              <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shape" Property="Fill" Value="{StaticResource GoldHi}"/>
                <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource GoldHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shape" Property="Fill" Value="{StaticResource GoldLo}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" Padding="2,2" BorderThickness="0,0,0,1" BorderBrush="Transparent">
              <ContentPresenter RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource GoldHi}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent"><ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2C2C31"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModeToggle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" Background="Transparent" Padding="14,5" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource GoldHi}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#26262B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LangToggle" TargetType="RadioButton" BasedOn="{StaticResource ModeToggle}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" Background="Transparent" Padding="7,5" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource GoldLo}"/><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource GoldHi}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#26262B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TabHeader" TargetType="RadioButton" BasedOn="{StaticResource ModeToggle}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="False"/>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#1A1A1D"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource GoldLo}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="4,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="16" Height="16" BorderBrush="{StaticResource Text2}" BorderThickness="1.5" Background="Transparent" VerticalAlignment="Top" Margin="0,1,0,0">
                <Path x:Name="Mark" Data="M2.5,7.5 L6,11 L13,3.5" Stroke="#161618" StrokeThickness="2" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter RecognizesAccessKey="True" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Gold}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GoldHi}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GoldHi}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="#3A3A41" Margin="2"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb"><Border Background="#3A3A41" Margin="2"/></ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Grid" TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="Transparent"/>
      <Setter Property="AlternatingRowBackground" Value="#1A1A1D"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="RowHeight" Value="30"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ColumnHeaderStyle">
        <Setter.Value>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="CellStyle">
        <Setter.Value>
          <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2A2620"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Light"/>
      <Setter Property="FontSize" Value="30"/>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#2A2A2F" BorderThickness="1" Background="#161618">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid Grid.Row="0" Background="#121214">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
        <Image Source="{StaticResource LogoImage}" Width="22" Height="22"/>
        <TextBlock Text="PathShrink" FontFamily="Segoe UI Light" FontSize="19" Margin="10,0,0,2" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Text="1.0.0" Foreground="{StaticResource Text2}" FontSize="11" Margin="8,4,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,18,0">
          <RadioButton x:Name="LangEN" Style="{StaticResource LangToggle}" GroupName="Lang" Content="EN" ToolTip="English"/>
          <RadioButton x:Name="LangES" Style="{StaticResource LangToggle}" GroupName="Lang" Content="ES" ToolTip="Espa&#241;ol"/>
          <RadioButton x:Name="LangPT" Style="{StaticResource LangToggle}" GroupName="Lang" Content="PT" ToolTip="Portugu&#234;s"/>
          <Border Width="1" Background="#33333A" Margin="12,4,12,4"/>
          <RadioButton x:Name="ModeBasic" Style="{StaticResource ModeToggle}" GroupName="Mode" IsChecked="True" Content="{{mode.basic}}" ToolTip="{{mode.basic.tip}}" AutomationProperties.Name="{{mode.basic.name}}"/>
          <RadioButton x:Name="ModePro" Style="{StaticResource ModeToggle}" GroupName="Mode" Content="{{mode.pro}}" ToolTip="{{mode.pro.tip}}" AutomationProperties.Name="{{mode.pro.name}}"/>
        </StackPanel>
        <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="{{caption.min}}"/>
        <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="{{caption.max}}"/>
        <Button x:Name="BtnClose" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" AutomationProperties.Name="{{caption.close}}"/>
      </StackPanel>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="SideColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="28,18,28,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Steps -->
        <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,0,0,14">
          <TextBlock x:Name="Step1" Text="{{step.1}}" Margin="0,0,22,0"/>
          <TextBlock x:Name="Step2" Text="{{step.2}}" Margin="0,0,22,0"/>
          <TextBlock x:Name="Step3" Text="{{step.3}}" Margin="0,0,22,0"/>
          <TextBlock x:Name="Step4" Text="{{step.4}}" Margin="0,0,22,0"/>
          <TextBlock x:Name="Step5" Text="{{step.5}}"/>
        </StackPanel>

        <!-- Folder card -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18,14" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="FolderPath" Text="{{folder.looking}}" FontFamily="Segoe UI Semibold" FontSize="15" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="FolderInfo" Text="" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnFolder" Style="{StaticResource CutButton}" Content="{{folder.change}}" Margin="12,0,0,0" ToolTip="{{folder.change.tip}}" AutomationProperties.Name="{{folder.change.name}}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main area: one panel visible at a time -->
        <Grid Grid.Row="2">
          <!-- Start -->
          <Grid x:Name="PanelStart">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
              <TextBlock Text="{{start.title}}" FontFamily="Segoe UI Light" FontSize="24" TextWrapping="Wrap" TextAlignment="Center"/>
              <TextBlock Style="{StaticResource Hint}" FontSize="13.5" TextAlignment="Center" Margin="0,14,0,0" LineHeight="21">
                {{start.body}}</TextBlock>
              <Button x:Name="BtnScan" Style="{StaticResource PrimaryButton}" Content="{{start.scan}}" HorizontalAlignment="Center" Margin="0,26,0,0" MinWidth="220" AutomationProperties.Name="{{start.scan.name}}"/>
              <TextBlock x:Name="StartNote" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,14,0,0" Text="{{start.note}}"/>
            </StackPanel>
          </Grid>

          <!-- Working -->
          <Grid x:Name="PanelWork" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
              <TextBlock x:Name="WorkTitle" Text="{{work.scanning}}" FontFamily="Segoe UI Light" FontSize="24" TextAlignment="Center"/>
              <ProgressBar x:Name="WorkBar" Height="3" Margin="0,20,0,0" IsIndeterminate="True" Foreground="{StaticResource Gold}" Background="#2A2A2F" BorderThickness="0"/>
              <TextBlock x:Name="WorkDetail" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,12,0,0" Text=""/>
              <Button x:Name="BtnCancel" Style="{StaticResource CutButton}" Content="{{work.cancel}}" HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
          </Grid>

          <!-- Results -->
          <Grid x:Name="PanelResults" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,10" Margin="0,0,10,0">
                <StackPanel><TextBlock x:Name="TileItems" Style="{StaticResource TileValue}" Text="0"/><TextBlock Text="{{tile.items}}" Style="{StaticResource Hint}"/></StackPanel>
              </Border>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,10" Margin="0,0,10,0" ToolTip="{{tile.long.tip}}">
                <StackPanel><TextBlock x:Name="TileLong" Style="{StaticResource TileValue}" Text="0"/><TextBlock x:Name="TileLongLabel" Text="" Style="{StaticResource Hint}"/></StackPanel>
              </Border>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,10" Margin="0,0,10,0">
                <StackPanel><TextBlock x:Name="TileFixed" Style="{StaticResource TileValue}" Foreground="{StaticResource Ok}" Text="0"/><TextBlock Text="{{tile.fixed}}" Style="{StaticResource Hint}"/></StackPanel>
              </Border>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,10">
                <StackPanel><TextBlock x:Name="TileLeft" Style="{StaticResource TileValue}" Text="0"/><TextBlock Text="{{tile.left}}" Style="{StaticResource Hint}"/></StackPanel>
              </Border>
            </UniformGrid>

            <Border Grid.Row="1" x:Name="Explain" BorderBrush="{StaticResource Gold}" BorderThickness="2,0,0,0" Padding="14,6" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="ExplainText" TextWrapping="Wrap" LineHeight="20"/>
                <Button x:Name="BtnTrimOffer" Style="{StaticResource LinkButton}" Content="{{explain.trimOffer}}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
              <RadioButton x:Name="TabChanges" Style="{StaticResource TabHeader}" GroupName="Tabs" IsChecked="True" Content="{{tab.changes}}"/>
              <RadioButton x:Name="TabPaths" Style="{StaticResource TabHeader}" GroupName="Tabs" Content="{{tab.paths}}"/>
              <RadioButton x:Name="TabIssues" Style="{StaticResource TabHeader}" GroupName="Tabs" Content="{{tab.issues}}" Visibility="Collapsed"/>
              <RadioButton x:Name="TabLog" Style="{StaticResource TabHeader}" GroupName="Tabs" Content="{{tab.log}}" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <Grid>
                <DataGrid x:Name="GridChanges" Style="{StaticResource Grid}" AutomationProperties.Name="{{grid.changes.name}}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="ColSelect" Header="" Width="38" Visibility="Collapsed">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=OneWay}" Tag="sel" ToolTip="{{col.include}}"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{{col.current}}" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <TextBlock Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Rel}"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{{col.new}}" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding NewName}" Foreground="#E2C48A" TextTrimming="CharacterEllipsis" ToolTip="{Binding NewName}"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{{col.saved}}" Binding="{Binding Saved}" Width="82"/>
                    <DataGridTextColumn Header="{{col.items}}" Binding="{Binding Affects}" Width="82"/>
                    <DataGridTextColumn x:Name="ColMethod" Header="{{col.how}}" Binding="{Binding MethodText}" Width="170" Visibility="Collapsed"/>
                    <DataGridTemplateColumn x:Name="ColParent" Header="{{col.folder}}" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Parent}" Style="{StaticResource Mono}" Foreground="#B8B8BC" ToolTip="{Binding Parent}"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="GridPaths" Style="{StaticResource Grid}" Visibility="Collapsed" AutomationProperties.Name="{{grid.paths.name}}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{{col.status}}" Width="120">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" Foreground="{Binding Color}"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{{col.before}}" Binding="{Binding Before}" Width="64"/>
                    <DataGridTextColumn Header="{{col.after}}" Binding="{Binding After}" Width="64"/>
                    <DataGridTemplateColumn Header="{{col.path}}" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Rel}" Style="{StaticResource Mono}" ToolTip="{Binding NewRel}"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="GridIssues" Style="{StaticResource Grid}" Visibility="Collapsed" AutomationProperties.Name="{{grid.issues.name}}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="{{col.issue}}" Binding="{Binding Issue}" Width="220"/>
                    <DataGridTextColumn Header="{{col.type}}" Binding="{Binding TypeText}" Width="70"/>
                    <DataGridTemplateColumn Header="{{col.path}}" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Rel}" Style="{StaticResource Mono}" ToolTip="{Binding Rel}"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBox x:Name="LogBox" Visibility="Collapsed" IsReadOnly="True" Background="Transparent" Foreground="#B8B8BC" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10" AutomationProperties.Name="{{tab.log}}"/>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
              </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRescan" Style="{StaticResource LinkButton}" Content="{{results.rescan}}" Margin="0,0,18,0"/>
                <Button x:Name="BtnExport" Style="{StaticResource LinkButton}" Content="{{results.export}}" Margin="0,0,18,0" ToolTip="{{results.export.tip}}"/>
              </StackPanel>
              <Button x:Name="BtnApply" Style="{StaticResource PrimaryButton}" Content="" HorizontalAlignment="Right" MinWidth="200"/>
            </Grid>
          </Grid>

          <!-- Done -->
          <Grid x:Name="PanelDone" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="660">
              <TextBlock x:Name="DoneTitle" Text="{{done.title}}" FontFamily="Segoe UI Light" FontSize="26" TextAlignment="Center"/>
              <TextBlock x:Name="DoneText" Style="{StaticResource Hint}" FontSize="13.5" TextAlignment="Center" Margin="0,14,0,0" LineHeight="21"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button x:Name="BtnUndo" Style="{StaticResource CutButton}" Content="{{done.undo}}" Margin="0,0,12,0"/>
                <Button x:Name="BtnReports" Style="{StaticResource CutButton}" Content="{{done.reports}}" Margin="0,0,12,0"/>
                <Button x:Name="BtnAgain" Style="{StaticResource PrimaryButton}" Content="{{done.again}}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- Pro settings -->
      <Border Grid.Column="1" x:Name="SidePanel" Background="#19191C" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
          <StackPanel>
            <TextBlock Text="{{side.rules}}" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{{side.limit}}"/><TextBlock Style="{StaticResource Hint}" Text="{{side.limit.hint}}"/></StackPanel>
              <TextBox x:Name="OptLimit" Grid.Column="1" Style="{StaticResource Field}" Text="400" VerticalAlignment="Top" AutomationProperties.Name="{{side.limit}}"/>
            </Grid>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{{side.margin}}"/><TextBlock Style="{StaticResource Hint}" Text="{{side.margin.hint}}"/></StackPanel>
              <TextBox x:Name="OptMargin" Grid.Column="1" Style="{StaticResource Field}" Text="20" VerticalAlignment="Top" AutomationProperties.Name="{{side.margin}}"/>
            </Grid>
            <CheckBox x:Name="OptTrim" Style="{StaticResource Check}" Margin="0,4,0,4" AutomationProperties.Name="{{side.trim}}">
              <StackPanel>
                <TextBlock><Run Text="{{side.trim}}"/><Run Text="{{side.trim.tag}}" Foreground="#E0C060" FontSize="10.5" FontFamily="Segoe UI Semibold"/></TextBlock>
                <TextBlock Style="{StaticResource Hint}" Text="{{side.trim.hint}}"/>
              </StackPanel>
            </CheckBox>
            <Grid Margin="24,6,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{{side.minName}}"/><TextBlock Style="{StaticResource Hint}" Text="{{side.minName.hint}}"/></StackPanel>
              <TextBox x:Name="OptMinName" Grid.Column="1" Style="{StaticResource Field}" Text="20" VerticalAlignment="Top" AutomationProperties.Name="{{side.minName}}"/>
            </Grid>

            <TextBlock Text="{{side.scope}}" Style="{StaticResource SectionTitle}" Margin="0,6,0,8"/>
            <TextBlock Text="{{side.exclude}}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{{side.exclude.hint}}"/>
            <TextBox x:Name="OptExclude" Style="{StaticResource Field}" AcceptsReturn="True" Height="54" Margin="0,4,0,10" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{{side.exclude}}"/>
            <TextBlock Text="{{side.protect}}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{{side.protect.hint}}"/>
            <TextBox x:Name="OptProtect" Style="{StaticResource Field}" AcceptsReturn="True" Height="54" Margin="0,4,0,10" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{{side.protect}}"/>
            <TextBlock Text="{{side.prefix}}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{{side.prefix.hint}}"/>
            <TextBox x:Name="OptPrefix" Style="{StaticResource Field}" Margin="0,4,0,14" FontFamily="Consolas" AutomationProperties.Name="{{side.prefix}}"/>

            <Button x:Name="BtnReplan" Style="{StaticResource CutButton}" Content="{{side.replan}}" HorizontalAlignment="Left" ToolTip="{{side.replan.tip}}"/>

            <TextBlock Text="{{side.tools}}" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
            <Button x:Name="BtnUndoFile" Style="{StaticResource LinkButton}" Content="{{side.undoFile}}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="{{side.undoFile.tip}}"/>
            <Button x:Name="BtnEnv" Style="{StaticResource LinkButton}" Content="{{side.env}}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="{{side.env.tip}}"/>
            <Button x:Name="BtnOpenReports" Style="{StaticResource LinkButton}" Content="{{side.openReports}}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <Button x:Name="BtnCopyCli" Style="{StaticResource LinkButton}" Content="{{side.copyCli}}" HorizontalAlignment="Left" ToolTip="{{side.copyCli.tip}}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Grid Grid.Row="2" Background="#121214">
      <TextBlock x:Name="StatusText" Text="{{status.ready}}" Foreground="{StaticResource Text2}" FontSize="12" VerticalAlignment="Center" Margin="18,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="StatusRight" Text="" Foreground="{StaticResource Text2}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0"/>
    </Grid>

    <!-- Dialog overlay -->
    <Grid x:Name="Overlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#B0000000">
      <Border x:Name="DialogBox" Background="#1D1D20" BorderBrush="{StaticResource Gold}" BorderThickness="1" MaxWidth="620" MinWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" FontFamily="Segoe UI Light" FontSize="22" TextWrapping="Wrap"/>
          <StackPanel x:Name="DlgBody" Margin="0,14,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="DlgNo" Style="{StaticResource CutButton}" Content="{{dlg.cancel}}" Margin="0,0,12,0" IsCancel="True"/>
            <Button x:Name="DlgYes" Style="{StaticResource PrimaryButton}" Content="{{dlg.ok}}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
  </Border>
</Window>
